APP_NAME=ahang-khatkesh
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ahang_khatkesh
DB_USERNAME=ahang_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
CACHE_STORE=database
MAIL_MAILER=log
FFPROBE_BINARY=ffprobe
VITE_APP_NAME=ahang-khatkesh

MUSIC_STORAGE_QUOTA_BYTES=107374182400
MUSIC_STORAGE_HEADROOM_BYTES=1073741824
MUSIC_GC_ENABLED=false

FFMPEG_BINARY=ffmpeg
MUSIC_CONVERSIONS_ENABLED=true
MUSIC_FFMPEG_SHA256=
MUSIC_FFPROBE_SHA256=
