{
  "name": "ahang-khatkesh",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:architecture": "node scripts/check-architecture.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/check-effects.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write resources/js resources/css vite.config.ts vitest.config.ts index.html playwright.config.ts tests/Browser/*.ts scripts/*.mjs",
    "format:check": "prettier --check resources/js resources/css vite.config.ts vitest.config.ts index.html playwright.config.ts tests/Browser/*.ts scripts/*.mjs",
    "test:browser": "npm run build && node scripts/run-browser-tests.mjs",
    "test:architecture": "node --test scripts/roadmap.test.mjs",
    "audit:offline": "bash scripts/audit-npm.sh",
    "build:demo": "tsc --noEmit -p demo/tsconfig.json && vite build --config demo/vite.config.ts && node demo/generate-audio.mjs",
    "test:demo": "vitest run --config demo/vitest.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource/vazirmatn": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-intl": "^12.1.6",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "laravel-vite-plugin": "^3.1.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.12"
  }
}
